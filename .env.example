# Database (local Postgres now; a Supabase project's connection string works
# identically here later — this is a standard Postgres connection URL).
DATABASE_URL=postgres://chillis:chillis_dev_pw@localhost:5432/chillis_diner

# Session signing secret for admin auth cookies (swap for Supabase Auth later).
SESSION_SECRET=change-me-to-a-long-random-string

# Payment provider: "mock" (default, no live credentials required) or "mpesa".
PAYMENT_PROVIDER=mock

# Only required when PAYMENT_PROVIDER=mpesa (Safaricom Daraja API).
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Supabase (for future migration off local Postgres / for Storage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
